[submodule "nvim"]
	path = nvim
	url = git@github.com:Eutrius/dotfiles.git
	branch = nvim-branch
[submodule "tmux"]
	path = tmux
	url = git@github.com:Eutrius/dotfiles.git
	branch = tmux
[submodule "plugins/zsh-z"]
	path = plugins/zsh-z
	url = git@github.com:agkozak/zsh-z.git
[submodule "plugins/powerlevel10k"]
	path = plugins/powerlevel10k
	url = git@github.com:romkatv/powerlevel10k.git
[submodule "plugins/zsh-autosuggestions"]
	path = plugins/zsh-autosuggestions
	url = git@github.com:zsh-users/zsh-autosuggestions.git
[submodule "plugins/zsh-syntax-highlighting"]
	path = plugins/zsh-syntax-highlighting
	url = git@github.com:zsh-users/zsh-syntax-highlighting.git
